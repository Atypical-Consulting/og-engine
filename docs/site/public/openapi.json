    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns the current operational status of the API, including loaded fonts, supported formats and templates, and the running version.",
        "tags": ["Operations"],
        "security": [],
        "responses": {
          "200": {
            "description": "API is healthy and ready to serve requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "version", "fonts", "formats", "templates"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "degraded"],
                      "description": "`ok` — all systems operational. `degraded` — running but some non-critical subsystems are unavailable.",
                      "example": "ok"
                    },
                    "version": {
                      "type": "string",
                      "description": "Semantic version of the running API.",
                      "example": "0.1.0"
                    },
                    "fonts": {
                      "type": "array",
                      "description": "List of Google Font family names currently registered and available for rendering.",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "Outfit",
                        "Playfair Display",
                        "Sora",
                        "Inter",
                        "Roboto",
                        "Open Sans",
                        "Lato",
                        "Montserrat"
                      ]
                    },
                    "formats": {
                      "type": "array",
                      "description": "List of supported image format / dimension presets.",
                      "items": {
                        "type": "string",
                        "enum": ["og", "twitter", "square", "linkedin", "story"]
                      },
                      "example": ["og", "twitter", "square", "linkedin", "story"]
                    },
                    "templates": {
                      "type": "array",
                      "description": "List of available visual templates.",
                      "items": {
                        "type": "string",
                        "enum": ["default", "social-card", "blog-hero", "email-banner"]
                      },
                      "example": ["default", "social-card", "blog-hero", "email-banner"]
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "version": "0.1.0",
                  "fonts": [
                    "Outfit",
                    "Playfair Display",
                    "Sora",
                    "Inter",
                    "Roboto",
                    "Open Sans",
                    "Lato",
                    "Montserrat"
                  ],
                  "formats": ["og", "twitter", "square", "linkedin", "story"],
                  "templates": ["default", "social-card", "blog-hero", "email-banner"]
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
